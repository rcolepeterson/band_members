{
  "name": "band-members",
  "version": "1.0.0",
  "private": true,
  "description": "Six Degrees of Rock — static site with a Netlify Functions + Netlify Blobs backend for shared band submissions.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/",
    "test:layout": "node scripts/layout-tune.mjs --current",
    "audit:layout": "node scripts/layout-audit.mjs",
    "audit:layout:csv": "node scripts/layout-audit.mjs --data fixture",
    "audit:layout:prod": "node scripts/layout-audit.mjs --data production",
    "audit:layout:refresh": "node scripts/layout-audit.mjs --refresh-data --data production",
    "vendor": "node scripts/vendor-libs.mjs",
    "vendor:fonts": "node scripts/vendor-fonts.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@netlify/blobs": "^8.1.0",
    "pureimage": "^0.4.20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@sigma/node-border": "^3.0.0",
    "d3": "^7.9.0",
    "esbuild": "^0.28.2",
    "graphology": "^0.26.0",
    "graphology-shortest-path": "^2.1.0",
    "playwright-core": "^1.56.0",
    "sigma": "^3.0.3"
  }
}
